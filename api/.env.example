# Copie para .env e preencha. Sem nenhuma chave, tudo roda com regras locais (a demo nunca quebra).

# IA: Gemini (padrão). Aceita LLM_API_KEY ou GEMINI_API_KEY.
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-3.5-flash-lite
LLM_API_KEY=coloque_sua_chave_aqui
# GEMINI_API_KEY=
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta

# IA: OpenAI (usada com LLM_PROVIDER=openai, ou se só esta chave existir).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/doacerto
DATABASE_URL=sqlite:///./doacerto.db

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Open-Meteo: gratuito, sem chave. Desligue para trabalhar offline.
CLIMA_ENABLED=true
FRIO_LIMITE_C=13
FRIO_EXTREMO_C=8
CALOR_LIMITE_C=30

# Central de operações: geocoding (Nominatim) e rotas (OSRM), ambos públicos e sem chave.
# Desligados, caem para o dicionário de lugares e para a estimativa em linha reta.
NOMINATIM_ENABLED=true
OSRM_ENABLED=true
